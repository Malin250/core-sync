# ============================================================
#  Core Sync Service - Environment Variables Template
#
#  1. Copy this file:  cp .env.example .env
#  2. Fill in every value marked ACTION REQUIRED.
#  3. NEVER commit the .env file — it is listed in .gitignore.
# ============================================================

# ---------- Database ----------
DB_URL=jdbc:postgresql://localhost:5432/coresync
DB_USERNAME=postgres
# ACTION REQUIRED: Set a strong database password.
DB_PASSWORD=Auca

# ---------- JPA ----------
JPA_DDL_AUTO=update
JPA_SHOW_SQL=false
JPA_OPEN_IN_VIEW=false

# ---------- JWT ----------
# ACTION REQUIRED: Run `openssl rand -hex 32` and paste the result here.
JWT_SECRET_KEY=6JSPe0CseB7QLqHQbxJuwDlERIVu+S4XHpGBVXni5LM=
JWT_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000

# ---------- AI API ----------
AI_API_URL=https://api.openai.com/v1/chat/completions
# ACTION REQUIRED: Paste your OpenAI API key.
AI_API_KEY=your_openai_key_here.
AI_API_MODEL=gpt-4o-mini
AI_SYSTEM_PROMPT=You are a helpful assistant for the Core Sync Service app.
AI_CHAT_HISTORY_LIMIT=5

# ---------- Firebase ----------
# ACTION REQUIRED: Generate a service-account key in Firebase Console:
#   Project Settings → Service Accounts → Generate new private key
# Then base64-encode it and paste below:
#   base64 -w 0 serviceAccountKey.json
FIREBASE_SERVICE_ACCOUNT_

# Alternatively, for local dev only, point to the raw JSON file:
# FIREBASE_SERVICE_ACCOUNT_PATH=/path/to/serviceAccountKey.json

# ACTION REQUIRED: Your Firebase Storage bucket name, e.g. your-project-id.appspot.com
# Found in Firebase Console → Storage → Files (shown in the top bar)
FIREBASE_STORAGE_BUCKET=medihafi.firebasestorage.app
# ---------- Feature Flags ----------
# Set to false in production.
SWAGGER_ENABLED=true
LOG_LEVEL=INFO
